{
  "name": "liberusoftware/module-manager-filament",
  "description": "Filament operations presentation adapter for the Liberu Module Manager.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "filament/filament": "^5.11.0",
    "liberusoftware/module-manager": "^1.8"
  },
  "suggest": {
    "liberusoftware/observability": "Lets users implementing ObservabilityActor reach the page when the application defines no viewModuleDiagnostics gate."
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Foundation\\ModuleManagerFilament\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "module-manager-filament"
    }
  },
  "version": "1.8.0",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Foundation\\ModuleManagerFilament\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "livewire/livewire": "^4.0",
    "pestphp/pest": "^5.3.3"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "liberusoftware/module-manager",
        "version": "1.8.0",
        "type": "liberu-module",
        "source": {
          "type": "git",
          "url": "https://github.com/liberusoftware/module-module-manager.git",
          "reference": "a3fe685a9b42ab945eb98455e5f5bd6d923031d9"
        },
        "require": {
          "php": "^8.5",
          "composer/semver": "^3.5.2",
          "illuminate/contracts": "^13.38.0",
          "illuminate/database": "^13.38.0",
          "illuminate/support": "^13.38.0"
        },
        "autoload": {
          "psr-4": {
            "Liberu\\Foundation\\ModuleManager\\": "src/"
          }
        },
        "extra": {
          "liberu": {
            "name": "module-manager"
          }
        }
      }
    }
  ]
}
